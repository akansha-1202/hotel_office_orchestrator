{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregate hotel offers from two mock suppliers using Temporal and Redis",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/temporal/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/temporal/worker.js"
  },
  "keywords": ["hotel", "temporal", "redis", "express"],
  "license": "MIT",
  "dependencies": {
    "@temporalio/activity": "^1.11.7",
    "@temporalio/client": "^1.11.7",
    "@temporalio/worker": "^1.11.7",
    "@temporalio/workflow": "^1.11.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
